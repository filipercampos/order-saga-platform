{
  "name": "order-saga-platform",
  "version": "0.1.0",
  "description": "Order, inventory, payment and notification services coordinated by an orchestrated saga over SNS/SQS",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "eslint \"{apps,libs,test,tools}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs,test,tools}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:all": "npm test && npm run test:int",
    "provision:local": "tsx tools/provision.ts",
    "dlq:redrive": "tsx tools/dlq-redrive.ts",
    "projection:replay": "tsx apps/order/src/history/replay-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1031.0",
    "@aws-sdk/client-sqs": "^3.1031.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "aws-jwt-verify": "^5.1.1",
    "kysely": "^0.28.16",
    "mongodb": "^6.21.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "5.7",
    "typescript-eslint": "^8.58.0"
  }
}
