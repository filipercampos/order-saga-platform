# Used by `npm run provision:local`, `npm run dlq:redrive` and `npm run projection:replay`
# against the docker compose stack. The services themselves are configured in
# docker-compose.yml.
AWS_ENDPOINT_URL=http://localhost:4567
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
MESSAGING_NAMESPACE=saga-local
MONGO_URL=mongodb://localhost:27018/?directConnection=true
